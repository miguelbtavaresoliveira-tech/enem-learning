# API principal: a API oficial do ENEM. Deixe vazio para usar https://api.enem.dev/v1
VITE_ENEM_API_URL=
# Fallback quando a API oficial falhar. Deixe vazio para usar /v1, que o proxy do Vite
# encaminha para a enem-api local (http://localhost:3000, dados da pasta enem-api/public).
VITE_ENEM_API_FALLBACK=
